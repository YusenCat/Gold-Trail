# Publish only the minimum playable package; excluded files remain on this machine.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/package.json
!/启动游戏.cmd
!/apps/
!/packages/
!/content/
!/docs/
!/tools/
!/Dockerfile
!/.dockerignore
!/deploy/

# Runtime rulebook and the release's player playtest record.
/docs/*
!/docs/RULEBOOK_V1.md
!/docs/PLAYTEST_3_4_0.md
!/docs/PLAYTEST_3_5_0.md
!/docs/ONLINE_4_0_PLAN.md
!/docs/ONLINE_DEPLOYMENT.md

# Only the launcher and Windows runtime finder are needed to play.
/tools/*
!/tools/start-game.mjs
!/tools/start-game.ps1

# Rules source is required; tests and the comparison bot are development files.
/packages/*
!/packages/rules/
/packages/rules/*
!/packages/rules/src/
/packages/rules/src/bot-baseline.ts
/apps/server/*.test.ts
!/apps/server/deployment.test.ts
!/apps/server/public-http.test.ts

# Card PNGs are runtime art. UI PNGs are originals; runtime uses WebP.
/apps/web/assets/ui/*.png
/apps/web/assets/board-map.png
/apps/web/assets/board-background.jpg
/apps/web/assets/board-illustration.svg

# Machine data, dependencies, caches, generated output and private configuration.
**/node_modules/
**/.env
**/.env.*
*.log
*.tmp
*.tsbuildinfo
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
!/CHANGELOG.md
